# Diretorio local do OpenTofu/Terraform
.terraform/

# State (contem IDs e dados da infra)
*.tfstate
*.tfstate.*
*.tfstate.backup

# Lock do state
.terraform.tfstate.lock.info

# Crash logs
crash.log
crash.*.log

# Arquivos de override locais
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Variaveis com secrets (descomente se criar .tfvars sensivel)
*.tfvars
*.tfvars.json
!example.tfvars

# CLI config local
.terraformrc
terraform.rc

# Planos salvos
*.tfplan

# OS / editor
.DS_Store
*.swp
*~
.idea/
.vscode/
